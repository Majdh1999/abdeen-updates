    // --- Over-The-Air (OTA) Update Logic ---

    private fun checkForAppUpdates() {
        val currentVersionCode = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            packageManager.getPackageInfo(packageName, 0).longVersionCode.toInt()
        } else {
            @Suppress("DEPRECATION")
            packageManager.getPackageInfo(packageName, 0).versionCode
        }

        Thread {
            try {
                // Replace with your raw text link to version.txt
                val versionUrl = URL("https://yourdomain.com/version.txt")
                val remoteVersion = versionUrl.readText().trim().toIntOrNull() ?: return@Thread

                if (remoteVersion > currentVersionCode) {
                    runOnUiThread {
                        AlertDialog.Builder(this)
                            .setTitle("Update Available")
                            .setMessage("A new version of Abdeen Grand Store app is available. Would you like to update now?")
                            .setPositiveButton("Update") { _, _ ->
                                downloadAndInstallUpdate("https://yourdomain.com/app-release.apk")
                            }
                            .setNegativeButton("Later", null)
                            .show()
                    }
                }
            } catch (e: Exception) {
                e.printStackTrace()
            }
        }.start()
    }

    private fun downloadAndInstallUpdate(apkUrl: String) {
        Toast.makeText(this, "Downloading update...", Toast.LENGTH_SHORT).show()
        Thread {
            try {
                val url = URL(apkUrl)
                val connection = url.openConnection() as HttpURLConnection
                connection.connect()

                val input = connection.inputStream
                val outputFile = java.io.File(cacheDir, "update.apk")
                val output = java.io.FileOutputStream(outputFile)

                val data = ByteArray(1024)
                var count: Int
                while (input.read(data).also { count = it } != -1) {
                    output.write(data, 0, count)
                }
                output.flush()
                output.close()
                input.close()

                runOnUiThread {
                    promptInstall(outputFile)
                }
            } catch (e: Exception) {
                e.printStackTrace()
                runOnUiThread {
                    Toast.makeText(this, "Download failed: ${e.localizedMessage}", Toast.LENGTH_LONG).show()
                }
            }
        }.start()
    }

    private fun promptInstall(file: java.io.File) {
        val apkUri = androidx.core.content.FileProvider.getUriForFile(
            this,
            "${packageName}.fileprovider",
            file
        )
        val intent = Intent(Intent.ACTION_VIEW).apply {
            setDataAndType(apkUri, "application/vnd.android.package-archive")
            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        }
        startActivity(intent)
    }

