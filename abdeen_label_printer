    // --- Cloud Sync for Master Catalog ---

    private fun syncMasterCatalogFromCloud() {
        Toast.makeText(this, "Syncing Master Catalog from cloud...", Toast.LENGTH_SHORT).show()

        Thread {
            try {
                val url = URL(CLOUD_MASTER_URL)
                val connection = url.openConnection() as HttpURLConnection
                connection.requestMethod = "GET"
                connection.connectTimeout = 10000
                connection.readTimeout = 10000

                if (connection.responseCode == HttpURLConnection.HTTP_OK) {
                    val reader = BufferedReader(InputStreamReader(connection.inputStream))
                    val newCatalog = mutableMapOf<String, ProductInfo>()
                    var line: String?
                    var isFirstLine = true

                    while (reader.readLine().also { line = it } != null) {
                        if (isFirstLine) {
                            isFirstLine = false
                            continue
                        }

                        val parts = line!!.split(",")
                        if (parts.size >= 3) {
                            val barcode = parts[0].trim().removeSurrounding("\"")
                            val description = parts[1].trim().removeSurrounding("\"")
                            val price = parts[2].trim().removeSurrounding("\"")

                            if (barcode.isNotEmpty()) {
                                newCatalog[barcode] = ProductInfo(description, price)
                            }
                        }
                    }
                    reader.close()

                    runOnUiThread {
                        if (newCatalog.isNotEmpty()) {
                            masterCatalog.clear()
                            masterCatalog.putAll(newCatalog)
                            saveMasterCatalogToPrefs()
                            updateStatusText()
                            Toast.makeText(this, "Successfully synced ${masterCatalog.size} products from cloud!", Toast.LENGTH_LONG).show()
                        } else {
                            Toast.makeText(this, "Cloud sheet appeared empty.", Toast.LENGTH_LONG).show()
                        }
                    }
                } else {
                    runOnUiThread {
                        Toast.makeText(this, "Server error: ${connection.responseCode}", Toast.LENGTH_LONG).show()
                    }
                }
            } catch (e: Exception) {
                e.printStackTrace()
                runOnUiThread {
                    Toast.makeText(this, "Sync failed: ${e.localizedMessage}", Toast.LENGTH_LONG).show()
                }
            }
        }.start()
    }

    // --- Smart Search & Add Function ---

    private fun searchAndAddProduct(query: String) {
        if (masterCatalog.containsKey(query)) {
            handleScannedBarcode(query)
            return
        }

        val matches = mutableListOf<Pair<String, ProductInfo>>()
        for ((barcode, info) in masterCatalog) {
            if (barcode.contains(query, ignoreCase = true) ||
                info.description.contains(query, ignoreCase = true)) {
                matches.add(Pair(barcode, info))
            }
        }

        when (matches.size) {
            0 -> Toast.makeText(this, "No products found matching '$query'", Toast.LENGTH_LONG).show()
            1 -> handleScannedBarcode(matches[0].first)
            else -> {
                val displayItems = matches.map { "${it.second.description}\nPrice: ${it.second.price} JD | Code: ${it.first}" }.toTypedArray()
                AlertDialog.Builder(this)
                    .setTitle("Select Product (${matches.size} found)")
                    .setItems(displayItems) { _, which ->
                        handleScannedBarcode(matches[which].first)
                    }
                    .setNegativeButton("Cancel", null)
                    .show()
            }
        }
    }

    // --- Persistence Methods ---

    private fun saveMasterCatalogToPrefs() {
        try {
            val jsonObject = JSONObject()
            for ((k, v) in masterCatalog) {
                val itemObj = JSONObject().apply {
                    put("description", v.description)
                    put("price", v.price)
                }
                jsonObject.put(k, itemObj)
            }
            getSharedPreferences(PREF_NAME, MODE_PRIVATE)
                .edit().putString(KEY_MASTER, jsonObject.toString()).apply()
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }

    private fun loadMasterCatalogFromPrefs() {
        val jsonStr = getSharedPreferences(PREF_NAME, MODE_PRIVATE).getString(KEY_MASTER, null) ?: return
        try {
            val jsonObject = JSONObject(jsonStr)
            masterCatalog.clear()
            for (key in jsonObject.keys()) {
                val obj = jsonObject.getJSONObject(key)
                masterCatalog[key] = ProductInfo(
                    description = obj.getString("description"),
                    price = obj.getString("price")
                )
            }
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }

    private fun saveBatchToPrefs() {
        try {
            val jsonArray = JSONArray()
            for (item in labelList) {
                val obj = JSONObject().apply {
                    put("barcode", item.barcode)
                    put("description", item.description)
                    put("price", item.price)
                    put("quantity", item.quantity)
                }
                jsonArray.put(obj)
            }
            getSharedPreferences(PREF_NAME, MODE_PRIVATE)
                .edit().putString(KEY_BATCH, jsonArray.toString()).apply()
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }

    private fun loadBatchFromPrefs() {
        val jsonStr = getSharedPreferences(PREF_NAME, MODE_PRIVATE).getString(KEY_BATCH, null) ?: return
        try {
            val jsonArray = JSONArray(jsonStr)
            labelList.clear()
            for (i in 0 until jsonArray.length()) {
                val obj = jsonArray.getJSONObject(i)
                labelList.add(
                    ProductLabel(
                        barcode = obj.getString("barcode"),
                        description = obj.getString("description"),
                        price = obj.getString("price"),
                        quantity = obj.getInt("quantity")
                    )
                )
            }
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }

    // --- Auto-Connect Printer ---

    private fun tryAutoConnectPrinter() {
        val prefs = getSharedPreferences(PREF_NAME, MODE_PRIVATE)
        val mac = prefs.getString(KEY_PRINTER_MAC, null) ?: return
        if (bluetoothAdapter == null) return

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
            if (ActivityCompat.checkSelfPermission(this, Manifest.permission.BLUETOOTH_CONNECT) != PackageManager.PERMISSION_GRANTED) {
                return
            }
        }

        try {
            val device = bluetoothAdapter?.getRemoteDevice(mac)
            if (device != null) {
                Thread {
                    try {
                        bluetoothSocket?.close()
                        val socket = device.createRfcommSocketToServiceRecord(PORT_UUID)
                        socket.connect()
                        bluetoothSocket = socket
                        selectedDeviceName = device.name ?: "Printer"
                        runOnUiThread {
                            updateStatusText()
                            Toast.makeText(this, "Auto-connected to $selectedDeviceName", Toast.LENGTH_SHORT).show()
                        }
                    } catch (e: Exception) {
                        e.printStackTrace()
                    }
                }.start()
            }
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }

    @SuppressLint("MissingPermission")
    private fun showBluetoothDevicesDialog() {
        if (bluetoothAdapter == null) {
            Toast.makeText(this, "Bluetooth not supported on this device", Toast.LENGTH_SHORT).show()
            return
        }

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
            if (ActivityCompat.checkSelfPermission(this, Manifest.permission.BLUETOOTH_CONNECT) != PackageManager.PERMISSION_GRANTED) {
                ActivityCompat.requestPermissions(this, arrayOf(Manifest.permission.BLUETOOTH_CONNECT, Manifest.permission.BLUETOOTH_SCAN), 101)
                return
            }
        }

        val pairedDevices: Set<BluetoothDevice>? = bluetoothAdapter?.bondedDevices
        if (pairedDevices.isNullOrEmpty()) {
            Toast.makeText(this, "No paired Bluetooth printers found.", Toast.LENGTH_LONG).show()
            return
        }

        val deviceList = pairedDevices.toList()
        val deviceNames = deviceList.map { "${it.name}\n${it.address}" }.toTypedArray()

        AlertDialog.Builder(this)
            .setTitle("Select Bluetooth Printer")
            .setItems(deviceNames) { _, which ->
                connectToPrinter(deviceList[which])
            }
            .show()
    }

    @SuppressLint("MissingPermission")
    private fun connectToPrinter(device: BluetoothDevice) {
        try {
            bluetoothSocket?.close()
            val socket = device.createRfcommSocketToServiceRecord(PORT_UUID)
            socket.connect()
            bluetoothSocket = socket
            selectedDeviceName = device.name ?: "Printer"

            getSharedPreferences(PREF_NAME, MODE_PRIVATE).edit().putString(KEY_PRINTER_MAC, device.address).apply()

            updateStatusText()
            Toast.makeText(this, "Connected to $selectedDeviceName!", Toast.LENGTH_SHORT).show()
        } catch (e: Exception) {
            e.printStackTrace()
            Toast.makeText(this, "Connection failed: ${e.localizedMessage}", Toast.LENGTH_LONG).show()
        }
    }

