    private fun handleScannedBarcode(scannedCode: String) {
        val existingIndex = labelList.indexOfFirst { it.barcode == scannedCode }
        if (existingIndex != -1) {
            labelList[existingIndex].quantity += 1
            adapter.notifyItemChanged(existingIndex)
            recyclerView.scrollToPosition(existingIndex)
            saveBatchToPrefs()
            updateStatusText()
            Toast.makeText(this, "Incremented quantity for: $scannedCode", Toast.LENGTH_SHORT).show()
            return
        }

        val productInfo = masterCatalog[scannedCode]
        if (productInfo != null) {
            val newLabel = ProductLabel(
                barcode = scannedCode,
                description = productInfo.description,
                price = productInfo.price,
                quantity = 1
            )
            labelList.add(newLabel)
            adapter.notifyItemInserted(labelList.size - 1)
            recyclerView.scrollToPosition(labelList.size - 1)
            saveBatchToPrefs()
            updateStatusText()
            Toast.makeText(this, "Added new item from Master Catalog!", Toast.LENGTH_SHORT).show()
        } else {
            Toast.makeText(this, "Barcode $scannedCode NOT found in Master Catalog!", Toast.LENGTH_LONG).show()
        }
    }

    private fun getCellString(cell: Cell?): String {
        if (cell == null) return ""
        return when (cell.cellType) {
            CellType.STRING -> cell.stringCellValue.trim()
            CellType.NUMERIC -> {
                val value = cell.numericCellValue
                if (value == value.toLong().toDouble()) {
                    value.toLong().toString()
                } else {
                    value.toString()
                }
            }
            CellType.BOOLEAN -> cell.booleanCellValue.toString()
            else -> cell.toString().trim()
        }
    }

    private fun loadBatchExcel(uri: Uri) {
        try {
            val inputStream: InputStream? = contentResolver.openInputStream(uri)
            val workbook = XSSFWorkbook(inputStream)
            val sheet = workbook.getSheetAt(0)

            labelList.clear()
            for (i in 0..sheet.lastRowNum) {
                val row = sheet.getRow(i) ?: continue
                val barcodeVal = getCellString(row.getCell(0))
                val description = getCellString(row.getCell(1))
                val price = getCellString(row.getCell(2))

                if (i == 0 && (barcodeVal.equals("Barcode", ignoreCase = true) ||
                            barcodeVal.equals("Code", ignoreCase = true) ||
                            barcodeVal.equals("Item", ignoreCase = true))) {
                    continue
                }

                if (barcodeVal.isNotEmpty()) {
                    labelList.add(ProductLabel(barcodeVal, description, price, 1))
                }
            }

            workbook.close()
            inputStream?.close()

            adapter.notifyDataSetChanged()
            saveBatchToPrefs()
            updateStatusText()
            Toast.makeText(this, "Batch loaded with ${labelList.size} items", Toast.LENGTH_SHORT).show()

        } catch (e: Exception) {
            e.printStackTrace()
            tvStatus.text = "Error loading Batch: ${e.localizedMessage}"
        }
    }

    private fun updateStatusText() {
        val batchCount = labelList.sumOf { it.quantity }
        tvStatus.text = "Printer: $selectedDeviceName | Batch: $batchCount labels"
    }

    // --- Standard 50x25mm Label Printing ---
    private fun printBatchLabels(includePrice: Boolean) {
        if (bluetoothSocket == null || !bluetoothSocket!!.isConnected) {
            Toast.makeText(this, "Select and connect a Bluetooth printer first!", Toast.LENGTH_LONG).show()
            return
        }
        if (labelList.isEmpty()) {
            Toast.makeText(this, "No labels to print in batch", Toast.LENGTH_SHORT).show()
            return
        }

        val prefs = getSharedPreferences(PREF_NAME, MODE_PRIVATE)
        val offsetX: Int
        val offsetY: Int

        if (includePrice) {
            offsetX = prefs.getInt(KEY_OFFSET_X_PRICE, 0)
            offsetY = prefs.getInt(KEY_OFFSET_Y_PRICE, 0)
        } else {
            offsetX = prefs.getInt(KEY_OFFSET_X_NOPRICE, 0)
            offsetY = prefs.getInt(KEY_OFFSET_Y_NOPRICE, 0)
        }

        try {
            val outputStream = bluetoothSocket!!.outputStream

            for (item in labelList) {
                val tspl = StringBuilder().apply {
                    append("SIZE 50 mm, 25 mm\n")
                    append("GAP 2 mm, 0 mm\n")
                    append("CLS\n")

                    if (includePrice && item.price.isNotEmpty()) {
                        append("BLOCK ${165 + offsetX}, ${3 + offsetY}, ${310 + offsetX}, ${16 + offsetY}, \"2\", 0, 1, 1, 2, \"ABDEEN GRAND STORES\"\n")
                        append("BLOCK ${180 + offsetX}, ${21 + offsetY}, ${310 + offsetX}, ${42 + offsetY}, \"1\", 0, 1, 1, 2, \"${item.description}\"\n")
                        append("BARCODE ${180 + offsetX}, ${58 + offsetY}, \"128\", 30, 1, 0, 2, 2, \"${item.barcode}\"\n")
                        append("BLOCK ${140 + offsetX}, ${125 + offsetY}, ${340 + offsetX}, ${50 + offsetY}, \"2\", 0, 2, 2, 2, \"  ${item.price} JD\"\n")
                    } else {
                        append("BLOCK ${165 + offsetX}, ${6 + offsetY}, ${310 + offsetX}, ${16 + offsetY}, \"2\", 0, 1, 1, 2, \"ABDEEN GRAND STORES\"\n")
                        append("BLOCK ${180 + offsetX}, ${26 + offsetY}, ${310 + offsetX}, ${85 + offsetY}, \"2\", 0, 1, 1, 2, \"${item.description}\"\n")
                        append("BARCODE ${180 + offsetX}, ${105 + offsetY}, \"128\", 55, 1, 0, 2, 2, \"${item.barcode}\"\n")
                    }

                    append("PRINT ${item.quantity},1\n")
                }

                outputStream.write(tspl.toString().toByteArray())
                outputStream.flush()
            }

            Toast.makeText(this, "Standard labels sent successfully!", Toast.LENGTH_LONG).show()

        } catch (e: Exception) {
            e.printStackTrace()
            Toast.makeText(this, "Printing error: ${e.localizedMessage}", Toast.LENGTH_LONG).show()
        }
    }
}

class LabelAdapter(
    private val items: List<ProductLabel>,
    private val onQuantityChanged: (Int, Int) -> Unit
) : RecyclerView.Adapter<LabelAdapter.LabelViewHolder>() {

    class LabelViewHolder(view: View) : RecyclerView.ViewHolder(view) {
        val imgPreview: ImageView = view.findViewById(R.id.imgPreview)
        val tvDescription: TextView = view.findViewById(R.id.tvDescription)
        val tvPrice: TextView = view.findViewById(R.id.tvPrice)
        val tvBarcodeDigits: TextView = view.findViewById(R.id.tvBarcodeDigits)
        val etQuantity: EditText = view.findViewById(R.id.etQuantity)
    }

    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): LabelViewHolder {
        val view = LayoutInflater.from(parent.context).inflate(R.layout.item_label, parent, false)
        return LabelViewHolder(view)
    }

    override fun onBindViewHolder(holder: LabelViewHolder, position: Int) {
        val item = items[position]
        holder.tvDescription.text = item.description
        holder.tvPrice.text = "Price: ${item.price}"
        holder.tvBarcodeDigits.text = item.barcode
        holder.etQuantity.setText(item.quantity.toString())

        try {
            val width = 450
            val height = 120
            val bitMatrix = MultiFormatWriter().encode(item.barcode, BarcodeFormat.CODE_128, width, height)
            val bmp = Bitmap.createBitmap(width, height, Bitmap.Config.RGB_565)
            for (x in 0 until width) {
                for (y in 0 until height) {
                    bmp.setPixel(x, y, if (bitMatrix[x, y]) Color.BLACK else Color.WHITE)
                }
            }
            holder.imgPreview.setImageBitmap(bmp)
        } catch (e: Exception) {
            e.printStackTrace()
        }

        if (holder.etQuantity.tag is TextWatcher) {
            holder.etQuantity.removeTextChangedListener(holder.etQuantity.tag as TextWatcher)
        }

        val watcher = object : TextWatcher {
            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
            override fun afterTextChanged(s: Editable?) {
                val currentPosition = holder.bindingAdapterPosition
                if (currentPosition != RecyclerView.NO_POSITION) {
                    val qty = s.toString().toIntOrNull() ?: 1
                    onQuantityChanged(currentPosition, qty)
                }
            }
        }
        holder.etQuantity.tag = watcher
        holder.etQuantity.addTextChangedListener(watcher)
    }

    override fun getItemCount() = items.size
}
